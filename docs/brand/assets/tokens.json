{
  "name": "The Website Factory",
  "version": "1.0",
  "status": "Proposed",
  "color": {
    "ink": "#172522",
    "paper": "#F8F6EF",
    "sage": "#E6EEE6",
    "lime": "#D9F46C",
    "pine": "#245C4C",
    "muted": "#4B6259",
    "border": "#6F817A",
    "divider": "#C9D4CB",
    "white": "#FFFFFF"
  },
  "font": {
    "family": "Inter",
    "stack": "Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Consolas, monospace",
    "weights": [
      400,
      500,
      600,
      700,
      800
    ],
    "file": "../../../static/fonts/inter-latin-variable.woff2",
    "license": "../../../static/fonts/OFL-inter.txt",
    "body": {
      "size": "1.125rem",
      "lineHeight": 1.6,
      "weight": 400
    },
    "display": {
      "size": "clamp(2.5rem, 6vw, 5rem)",
      "lineHeight": 1.04,
      "weight": 720,
      "tracking": "-.045em"
    },
    "heading": {
      "size": "clamp(1.75rem, 3vw, 2.625rem)",
      "lineHeight": 1.12,
      "weight": 700,
      "tracking": "-.03em"
    },
    "label": {
      "size": "0.9375rem",
      "lineHeight": 1.45,
      "weight": 600
    }
  },
  "layout": {
    "spacingPx": [
      4,
      8,
      16,
      24,
      32,
      48,
      64,
      96
    ],
    "contentMax": "70rem",
    "readingMax": "65ch",
    "cornerRadius": "0.5rem",
    "targetMin": "2.75rem"
  }
}
