{
  "name": "website-client-starter",
  "private": true,
  "version": "1.0.0",
  "description": "Optional local website quality tools; not required for Hugo builds",
  "type": "module",
  "scripts": {
    "check:browser": "node scripts/browser-checks.cjs",
    "audit": "node scripts/audit.mjs",
    "test:contact": "node scripts/test_contact_endpoint.mjs",
    "test:plan": "python3 scripts/test_from_plan.py",
    "test:starter": "python3 scripts/test_starter.py",
    "test:factory": "python3 scripts/test_factory.py",
    "test:integration": "sh scripts/check_contact.sh",
    "from-plan": "python3 scripts/from_plan.py",
    "test": "node scripts/test_contact_endpoint.mjs && python3 scripts/test_from_plan.py && python3 scripts/test_starter.py && python3 scripts/test_factory.py"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "lighthouse": "13.5.0",
    "playwright": "1.62.1"
  }
}
